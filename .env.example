# LOCAL ACCOUNTS
# LINGJIE Yudian#2026!
ATHENA_ACCOUNT_LINGJIE_ENABLED=true
ATHENA_ACCOUNT_LINGJIE_CAPABILITIES=login
# IMPORTANT: bcrypt hash contains '$'. If you use `source .env`, DO NOT use double quotes here.
# Use single quotes (recommended) or escape every '$' as '\$', otherwise shell expansion will corrupt
# the hash and login will fail with "Invalid username or password".
ATHENA_ACCOUNT_LINGJIE_PASSWORD_HASH='$2a$10$hUUrfFxt3WJxKnzbTqqf.ONFXuJuPYIFtl5qy2E3P.kQqtt4ge2Jq'
ATHENA_ACCOUNT_LINGJIE_PASSWORD_MTIME=2026-05-18T04:58:10Z
# YUDIAN Yudian#2026!
ATHENA_ACCOUNT_YUDIAN_ENABLED=true
ATHENA_ACCOUNT_YUDIAN_CAPABILITIES=login
# IMPORTANT: bcrypt hash contains '$'. If you use `source .env`, DO NOT use double quotes here.
# Use single quotes (recommended) or escape every '$' as '\$', otherwise shell expansion will corrupt
# the hash and login will fail with "Invalid username or password".
ATHENA_ACCOUNT_YUDIAN_PASSWORD_HASH='$2a$10$hUUrfFxt3WJxKnzbTqqf.ONFXuJuPYIFtl5qy2E3P.kQqtt4ge2Jq'
ATHENA_ACCOUNT_YUDIAN_PASSWORD_MTIME=2026-05-18T04:58:10Z
