# APPLICATION (athena-application)
# Node + ATHENA contract (required)
ATHENA_APPLICATION_NODE_WS_URL=ws://65.108.34.81:8546
# Default is false: node WS connects directly and ignores http_proxy/all_proxy.
# Set true only when you intentionally want ATHENA_APPLICATION_NODE_WS_URL to use proxy env vars.
ATHENA_APPLICATION_NODE_WS_USE_PROXY=false
ATHENA_APPLICATION_ATHENA_CONTRACT=0xA77bc042D130823DFf741BAC87689a1C419CFf8A
ATHENA_APPLICATION_LIQUIDITY_LOCKER_ADDRESSES=0x0000000000000000000000000000000000000000,0x000000000000000000000000000000000000dEaD
# gRPC address of athena-solidity (local: localhost:8090, docker: athena-solidity:8090)
ATHENA_APPLICATION_SOLIDITY_SERVER_ADDRESS=localhost:8090
# gRPC address of athena-wallet (local: localhost:8088, docker: athena-wallet:8088)
ATHENA_APPLICATION_WALLET_SERVER_ADDRESS=localhost:8088
# Ave API (project logo)
ATHENA_APPLICATION_AVE_API_KEY=EVLzXhZZohZA04DWbRkXA9Hkp6PvwaMDmaNqQon5tfZKAEF6BOVsT2xpQpbilWLQ
