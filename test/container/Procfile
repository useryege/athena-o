api-server: [ "$BIN_MODE" = 'true' ] && COMMAND=./dist/athena || COMMAND='go run ./cmd/main.go' && sh -c "FORCE_LOG_COLORS=1 ATHENA_FAKE_IN_CLUSTER=true ATHENA_BINARY_NAME=athena-server $COMMAND --loglevel debug --redis localhost:${ATHENA_E2E_REDIS_PORT:-6379} --disable-auth=${ATHENA_E2E_DISABLE_AUTH:-'true'} --insecure --port ${ATHENA_E2E_APISERVER_PORT:-8080}"
redis: sh -c "/usr/local/bin/redis-server --save "" --appendonly no --port ${ATHENA_E2E_REDIS_PORT:-6379}"

