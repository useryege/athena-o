# ── Required (when wiring trading / authenticated CLOB calls) ───────────────
# PRIVATE_KEY=0xREPLACE_ME
# CLOB_API_KEY=REPLACE_ME
# CLOB_API_SECRET=REPLACE_ME
# CLOB_API_PASSPHRASE=REPLACE_ME

# ── Optional ────────────────────────────────────────────────────────────────
# gRPC bind address (defaults below)
# GRPC_HOST=0.0.0.0
# GRPC_PORT=50051

# Polygon RPC (Polymarket CLOB defaults may use public endpoints; override here)
# RPC_URL=https://polygon-rpc.com/

# E2E: running sidecar address
# POLYMARKET_E2E_GRPC_ADDR=127.0.0.1:50051
