# ── Authenticated CLOB (private key + API creds required together) ───────────
# PK=0xREPLACE_ME
# (alias) PRIVATE_KEY=0xREPLACE_ME
# CHAIN_ID=137
# CLOB_API_KEY=REPLACE_ME
# CLOB_SECRET=REPLACE_ME
# (alias) CLOB_API_SECRET=REPLACE_ME
# CLOB_PASS_PHRASE=REPLACE_ME
# (alias) CLOB_API_PASSPHRASE=REPLACE_ME

# ── Optional ────────────────────────────────────────────────────────────────
# CLOB host (defaults to https://clob.polymarket.com)
# CLOB_API_URL=
# (alias) POLYMARKET_HOST=
# Outbound HTTPS proxy for SDK and E2E (axios)
# PROXY_URL=
# gRPC bind address (defaults below)
# GRPC_HOST=0.0.0.0
# GRPC_PORT=50051

# Polygon RPC (Polymarket CLOB defaults may use public endpoints; override here)
# RPC_URL=https://polygon-rpc.com/

# E2E: running sidecar address
# POLYMARKET_E2E_GRPC_ADDR=127.0.0.1:50051
