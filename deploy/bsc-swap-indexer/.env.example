# Dedicated target selected for the BSC swap indexer.
REMOTE_HOST=47.254.154.128

# Dedicated PostgreSQL 18 credentials and persistent Docker volume.
POSTGRES_USER=athena
POSTGRES_PASSWORD=change-me
BSC_SWAP_INDEXER_POSTGRES_VOLUME=athena-bsc-swap-indexer-postgres-data

# Private BSC Mainnet JSON-RPC endpoint reachable from the indexer server.
ATHENA_BSC_SWAP_NODE_RPC_URL=ws://88.99.103.60:8546

# Host exposure. Restrict TCP 8130 with the cloud security group or firewall.
BSC_SWAP_INDEXER_GRPC_BIND_ADDRESS=0.0.0.0
BSC_SWAP_INDEXER_GRPC_PORT=8130
BSC_SWAP_INDEXER_TELEMETRY_BIND_ADDRESS=127.0.0.1
BSC_SWAP_INDEXER_TELEMETRY_PORT=8131

# Optional scanner tuning. The log filter window is fixed at 100 blocks.
ATHENA_BSC_SWAP_FETCH_CONCURRENCY=16
ATHENA_BSC_SWAP_POLL_INTERVAL=1s
