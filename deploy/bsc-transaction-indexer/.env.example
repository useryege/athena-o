# Remote deployment target. REMOTE_HOST may instead be passed to make.
REMOTE_HOST=203.0.113.10

# Dedicated PostgreSQL 18 credentials and persistent Docker volume.
POSTGRES_USER=athena
POSTGRES_PASSWORD=change-me
BSC_INDEXER_POSTGRES_VOLUME=athena-bsc-transaction-indexer-postgres-data

# Private BSC Mainnet JSON-RPC endpoint reachable from the indexer server.
ATHENA_BSC_INBOUND_NODE_RPC_URL=http://127.0.0.1:8545

# Host exposure. Restrict TCP 8130 with the server firewall or cloud allowlist.
BSC_INDEXER_GRPC_BIND_ADDRESS=0.0.0.0
BSC_INDEXER_GRPC_PORT=8130
BSC_INDEXER_TELEMETRY_BIND_ADDRESS=127.0.0.1
BSC_INDEXER_TELEMETRY_PORT=8131

# Optional scanner tuning.
ATHENA_BSC_INBOUND_SCAN_BATCH_SIZE=1000
ATHENA_BSC_INBOUND_FETCH_CONCURRENCY=64
ATHENA_BSC_INBOUND_POLL_INTERVAL=1s
