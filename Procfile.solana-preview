# Requires an existing PostgreSQL database, Redis and the repository Node version.
# Explicit alternate ports and database prevent overlap with another checkout.
solana-discovery: sh -c 'ATHENA_SOLANA_DISCOVERY_POSTGRES_DSN=${ATHENA_SOLANA_PREVIEW_POSTGRES_DSN:?Set ATHENA_SOLANA_PREVIEW_POSTGRES_DSN to an isolated database} ATHENA_SOLANA_DISCOVERY_INTERNAL_AUTH_TOKEN=${ATHENA_SOLANA_DISCOVERY_INTERNAL_AUTH_TOKEN:-athena-local-solana-discovery-internal-auth-token-2026} go run ./cmd/athena-solana-discovery --range-size 1 --requests-per-second 1 --concurrency 1 --port ${ATHENA_SOLANA_PREVIEW_DISCOVERY_PORT:-18112}'
api-server: sh -c 'export ATHENA_ACCOUNT_STATE_POSTGRES_DSN=${ATHENA_SOLANA_PREVIEW_POSTGRES_DSN:?Set ATHENA_SOLANA_PREVIEW_POSTGRES_DSN to an isolated database} ATHENA_SOLANA_DISCOVERY_SERVER_ADDRESS=127.0.0.1:${ATHENA_SOLANA_PREVIEW_DISCOVERY_PORT:-18112} ATHENA_SOLANA_DISCOVERY_INTERNAL_AUTH_TOKEN=${ATHENA_SOLANA_DISCOVERY_INTERNAL_AUTH_TOKEN:-athena-local-solana-discovery-internal-auth-token-2026} ATHENA_NOTIFICATION_INTERNAL_AUTH_TOKEN=${ATHENA_NOTIFICATION_INTERNAL_AUTH_TOKEN:-athena-local-notification-internal-auth-token-2026} ATHENA_WALLET_INTERNAL_AUTH_TOKEN=${ATHENA_WALLET_INTERNAL_AUTH_TOKEN:-athena-local-wallet-internal-auth-token-2026} ATHENA_WORM_TRADING_INTERNAL_AUTH_TOKEN=${ATHENA_WORM_TRADING_INTERNAL_AUTH_TOKEN:-athena-local-worm-trading-internal-auth-token-2026} ATHENA_ACCOUNT_AVATAR_S3_ENDPOINT=${ATHENA_ACCOUNT_AVATAR_S3_ENDPOINT:-http://127.0.0.1:${ATHENA_MINIO_API_PORT:-9000}} ATHENA_ACCOUNT_AVATAR_S3_REGION=${ATHENA_ACCOUNT_AVATAR_S3_REGION:-us-east-1} ATHENA_ACCOUNT_AVATAR_S3_BUCKET=${ATHENA_ACCOUNT_AVATAR_S3_BUCKET:-athena-account-avatars} ATHENA_ACCOUNT_AVATAR_S3_ACCESS_KEY_ID=${ATHENA_ACCOUNT_AVATAR_S3_ACCESS_KEY_ID:-athena-local-avatar} ATHENA_ACCOUNT_AVATAR_S3_SECRET_ACCESS_KEY=${ATHENA_ACCOUNT_AVATAR_S3_SECRET_ACCESS_KEY:-athena-local-avatar-secret} ATHENA_ACCOUNT_AVATAR_S3_PATH_STYLE=${ATHENA_ACCOUNT_AVATAR_S3_PATH_STYLE:-true} ATHENA_ACCOUNT_AVATAR_MAX_BYTES=${ATHENA_ACCOUNT_AVATAR_MAX_BYTES:-2097152}; go run ./cmd/athena-account-state-migrate up && go run ./cmd/athena-account-state-migrate verify && exec go run ./cmd/athena-server --redisdb 13 --redis localhost:${ATHENA_REDIS_PORT:-6379} --disable-auth=${ATHENA_SERVER_DISABLE_AUTH:-false} --address 127.0.0.1 --port ${ATHENA_SOLANA_PREVIEW_API_PORT:-18080}'
ui: sh -c 'cd ui && ATHENA_API_URL=http://127.0.0.1:${ATHENA_SOLANA_PREVIEW_API_PORT:-18080} ${ATHENA_YARN_CMD:-yarn} start --host 127.0.0.1 --port ${ATHENA_SOLANA_PREVIEW_UI_PORT:-14000} --strictPort'
