  "findings": [
    "CTF helper encodes both binary index sets and no amount; actual affected balances must be disclosed.",
    "Protocol V2 position-specific router redemption freezes outcome and amount; generic market workflow can produce multiple calls.",
    "EOA multi-call workflow sends separate transactions; do not describe it as atomic.",
    "CTF independent index-set payout uses floor before summing, and 50/50 resolution cannot use a winner-only formula.",
    "OPEN include_archived does not include inactive; CLOSED must omit include_archived=true.",
    "Time-bounded positions omit rows without last_event_at, requiring unbounded periodic inventories.",
    "Existing CLOSED sample contains 265 positive-size rows; existing trade sample has no dedicated per-fill identity.",
    "Data API freshness reports overall lag and its snapshot age, not per-wallet completion."
  ],
  "unverified": [
    "Actual adapter/router deployments and allowed operators",
    "Account-specific redemption, fees, internal execution and payout receipt",
    "Historical contract coverage, archival RPC completeness and indexed asset gaps",
    "Canonical per-fill identity across sources, reorg and late correction recovery",
    "Stable local pagination, access/session races and frontend acceptance"
  ]
